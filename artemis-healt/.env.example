# ============================================================================
# ARTEMIS HEALTH — Variables de entorno del Backend (PLANTILLA SIN SECRETOS)
# ============================================================================
# IMPORTANTE:
# 1. Nunca incluyas secretos reales en este archivo ni en el repositorio Git.
# 2. Nunca expongas SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL ni DATABASE_ADMIN_URL
#    al frontend (React/Vite/Vercel).
# ============================================================================

# Modo de ejecución de la aplicación
ARTEMIS_MODE=demo

# Motor de persistencia: 'auto' (usa PostgreSQL/Supabase si está configurado,
# o SQLite persistente local en var/artemis_health.db), 'postgres', 'supabase_rest' o 'sqlite'
ARTEMIS_STORAGE=auto

# Conexión PostgreSQL de Supabase para el backend en ejecución (Supavisor Transaction Pooler TLS)
DATABASE_URL=

# Conexión exclusiva para operador local de migraciones (NO configurar en producción/Vercel)
DATABASE_ADMIN_URL=

# Credenciales de API de Supabase (opcionales si se usa conexión directa DATABASE_URL)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# EXCLUSIVO BACKEND — jamás exponer con prefijo VITE_ ni enviar al navegador
SUPABASE_SERVICE_ROLE_KEY=

# Ruta opcional para base persistente local en modo desarrollo/pruebas
ARTEMIS_SQLITE_PATH=var/artemis_health.db

# Orígenes permitidos por CORS (separados por coma: desarrollo local Vite y despliegue Vercel)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://artemis-health.vercel.app

# Nivel de logs (INFO, WARNING, ERROR)
LOG_LEVEL=INFO
